# ── Build output ──────────────────────────────────────────────────────────────
build*/
Testing/

# ── Compiled / object files ───────────────────────────────────────────────────
*.o
*.so
*.a

# ── HIP / ROCm artifacts ──────────────────────────────────────────────────────
*.bc
*.ll
*.pftrace

# ── Installed example binaries (compiled in-tree by cmake) ────────────────────
deploy/examples/square
deploy/examples/vecwork

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── CMake user overrides ──────────────────────────────────────────────────────
CMakeUserPresets.json

# ── Debian packaging artifacts ────────────────────────────────────────────────
debian/*.debhelper
debian/tmp/
debian/files
debian/*.substvars

# ── Top-level built binary ────────────────────────────────────────────────────
/hsa-snoop

# ── Generated JSON at repo root ───────────────────────────────────────────────
/*.json

# ── Runtime / scratch ─────────────────────────────────────────────────────────
results/
.obs-scratch/

# ── Spell-check compiled dictionary (created on local lint runs) ──────────────
dictionary.dic

# ── Generated docs files ──────────────────────────────────────────────────────
/docs/perf-history/index.html
/docs/perf-history/badge-*.json

# ── Editor / OS noise ─────────────────────────────────────────────────────────
*.swp
*~
.DS_Store
