[Unit]
Description=hsa-snoop — HSA/HIP AQL queue monitor with Prometheus exporter
Documentation=https://github.com/sbates130272/hsa-snoop
After=local-fs.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/hsa-snoop
ExecStart=/bin/sh -lc 'exec @HSA_SNOOP_EXECUTABLE@ --all --prometheus $HSA_SNOOP_ARGS'
Restart=on-failure
RestartSec=5s

# hsa-snoop needs root for tracefs, pagemap, process_vm_readv, and ptrace
# (CAP_SYS_PTRACE is used by the KFD debug-trap scan at startup).
# SUDO_UID/SUDO_GID are read from /etc/default/hsa-snoop and allow
# DetectGpuType() to call rocminfo as the GPU-capable console user on
# WSL2/DXG. postinst auto-detects these; edit /etc/default/hsa-snoop
# if the detected values are wrong for your system.
User=root

# Log through journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hsa-snoop

# Give the service time to flush in-flight scrapes / traces on shutdown.
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
